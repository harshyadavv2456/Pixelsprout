        g.cells.forEach(function (p) {
          if (p[0] > anchor[0] || (p[0] === anchor[0] && p[1] < anchor[1])) anchor = p;
        });
        var ax = layout.gx + anchor[1] * layout.cell + layout.cell / 2;
        var ay = layout.gy + anchor[0] * layout.cell + layout.cell / 2;
        var burstTier = g.t >= 5;
        var gained = burstTier
          ? 220 * g.cells.length * chain
          : (g.t + 2) * (g.t + 2) * g.cells.length * 3 * chain;
        noteScore(gained, ax, ay);
        burst(ax, ay, burstTier ? "#d7e7ff" : "#e7c27a", burstTier ? 18 : 8);
        if (burstTier) shake = Math.min(10, shake + 5);
        g.cells.forEach(function (p) { grid[p[0]][p[1]] = null; });
        var cracked = {};
        g.cells.forEach(function (p) {
          [[1, 0], [-1, 0], [0, 1], [0, -1]].forEach(function (d) {
            var rr = p[0] + d[0];
            var cc = p[1] + d[1];
            if (rr < 0 || cc < 0 || rr >= ROWS || cc >= COLS) return;
            var n = grid[rr][cc];
            if (n && n.kind === "pebble" && !cracked[rr + "," + cc]) {
              cracked[rr + "," + cc] = 1;
              if (burstTier) n.hp = 0;
              else n.hp -= 1;
              if (n.hp <= 0) {
                grid[rr][cc] = null;
                noteScore(40, layout.gx + cc * layout.cell + layout.cell / 2, layout.gy + rr * layout.cell);
              }
            }
          });
        });
        if (!burstTier) {
          grid[anchor[0]][anchor[1]] = { kind: "plant", t: g.t + 1, pop: 1.35, fallFrom: null };
        }
      });
      tone(320 + chain * 70, 0.12, "triangle", 0.05);
      if (groups.some(function (g) { return g.t >= 4; })) chord([523, 659, 784], 0.22, 0.04);
    }

    function gravityMoves() {
      var moved = false;
      for (var c = 0; c < COLS; c++) {
        var stack = [];
        for (var r = ROWS - 1; r >= 0; r--) if (grid[r][c]) stack.push({ cell: grid[r][c], r: r });
        for (var r2 = 0; r2 < ROWS; r2++) grid[r2][c] = null;
        for (var i = 0; i < stack.length; i++) {
          var dest = ROWS - 1 - i;
          var cell = stack[i].cell;
          if (stack[i].r !== dest) {
            moved = true;
            cell.fallFrom = stack[i].r;
          } else cell.fallFrom = null;
          grid[dest][c] = cell;
        }
      }
      return moved;
    }

    function beginResolve(chain) {
      var groups = findGroups();
      if (groups.length) {
        chainValue = chain;
        chainBanner = 1.1;
        anim = { kind: "pop", t: 0, dur: 0.16, groups: groups, chain: chain };
        return;
      }
      if (gravityMoves()) {
        anim = { kind: "grav", t: 0, dur: 0.14, chain: chain };
        return;
      }
      busy = false;
      anim = null;
      finishTurn();
    }

    function finishTurn() {
      var goal = EVENINGS[evening].goal;
      if (goal && score >= goal) {
        mode = "clear";
        save.unlocked = Math.max(save.unlocked, evening + 2);
        persist();
        chord([392, 494, 587, 784], 0.28, 0.05);
        return;
      }
      if (!canPlace(current)) {
        mode = "over";
        persist();
        tone(140, 0.3, "sine", 0.06);
      }
    }

    function applyRain(col) {
      var layout = measure();
      var top = null;
      var topR = -1;
      for (var r = 0; r < ROWS; r++) {
        if (grid[r][col]) { top = grid[r][col]; topR = r; break; }
      }
      var cx = layout.gx + col * layout.cell + layout.cell / 2;
      if (top && top.kind === "pebble") {
        grid[topR][col] = null;
        noteScore(50, cx, layout.gy + topR * layout.cell);
        burst(cx, layout.gy + topR * layout.cell, "#9fd4ea", 10);
        tone(680, 0.1, "sine", 0.04);
        return;
      }
      if (top && top.kind === "plant") {
        if (top.t < 5) top.t += 1;
        top.pop = 1.3;
        noteScore(30 * (top.t + 1), cx, layout.gy + topR * layout.cell);
        tone(520 + top.t * 40, 0.1, "sine", 0.045);
        return;
      }
      var row = landingRow(col);
      if (row >= 0) grid[row][col] = { kind: "plant", t: 0, pop: 1.2, fallFrom: null };
    }

    function drop(col) {
      if (mode !== "play" || busy || anim) return;
      if (col < 0 || col >= COLS) return;
      unlockAudio();
      resumeAudio();
      if (current.kind === "rain") {
        busy = true;
        applyRain(col);
        current = next;
        next = roll();
        beginResolve(1);
        return;
      }
      var row = landingRow(col);
      if (row < 0) {
        deny = col;
        tone(110, 0.08, "square", 0.03);
        return;
      }
      busy = true;
      anim = { kind: "fall", t: 0, dur: 0.09 + row * 0.018, col: col, row: row, piece: current };
      tone(220 + row * 12, 0.06, "sine", 0.03);
    }

    function finishAnim() {
      if (!anim) return;
      var a = anim;
      anim = null;
      if (a.kind === "fall") {
        grid[a.row][a.col] = makeCell(a.piece);
        current = next;
        next = roll();
        beginResolve(1);
        return;
      }
      if (a.kind === "pop") {
        applyGroups(a.groups, a.chain);
        if (gravityMoves()) anim = { kind: "grav", t: 0, dur: 0.14, chain: a.chain };
        else beginResolve(a.chain + 1);
        return;
      }
      if (a.kind === "grav") {
        for (var r = 0; r < ROWS; r++) for (var c = 0; c < COLS; c++) if (grid[r][c]) grid[r][c].fallFrom = null;
        beginResolve(a.chain);
      }
    }

    function measure() {
      var hud = Math.max(64, Math.min(88, cssH * 0.12));
      var pad = 14;
      var availW = cssW - pad * 2;
      var availH = cssH - hud - pad * 2;
      var cell = Math.max(28, Math.floor(Math.min(availW / COLS, availH / ROWS)));
      var gridW = cell * COLS;
      var gridH = cell * ROWS;
      return {
        hud: hud,
        cell: cell,
        gx: Math.round((cssW - gridW) / 2),
        gy: Math.round(hud + (cssH - hud - gridH) / 2),
        gridW: gridW,
        gridH: gridH
      };
    }

    function colAt(x, y) {
      var m = measure();
      if (y < m.gy - 8) return -1;
      var c = Math.floor((x - m.gx) / m.cell);
      if (c < 0 || c >= COLS) return -1;
      if (x < m.gx || x > m.gx + m.gridW) return -1;
      return c;
    }

    function roundRect(x, y, w, h, r) {
      var rr = Math.min(r, w / 2, h / 2);
      ctx.beginPath();
      ctx.moveTo(x + rr, y);
      ctx.arcTo(x + w, y, x + w, y + h, rr);
      ctx.arcTo(x + w, y + h, x, y + h, rr);
      ctx.arcTo(x, y + h, x, y, rr);
      ctx.arcTo(x, y, x + w, y, rr);
      ctx.closePath();
    }

    function drawSprite(index, x, y, size) {
      if (imgReady) {
        var sx = (index % 3) * 128;
        var sy = Math.floor(index / 3) * 128;
        ctx.drawImage(img, sx, sy, 128, 128, x, y, size, size);
        return;
      }
      var colors = ["#e2b15a", "#7fa872", "#3f7d4e", "#d9899b", "#e39a86", "#d7e7ff", "#8d8680", "#7ec4d8", "#e0a15a"];
      ctx.fillStyle = colors[index] || "#fff";
      ctx.beginPath();
