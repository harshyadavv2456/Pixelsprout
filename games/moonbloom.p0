/* Moonbloom — a Pixelsprout original. Tap a column, grow the garden. */
(function () {
  "use strict";

  var COLS = 6;
  var ROWS = 7;
  var KEY = "pixelsprout-moonbloom-v1";
  var EVENINGS = [
    { name: "First dew", goal: 180, line: "Tap a column. Three of the same plant touching by an edge grow into the next form." },
    { name: "Second leaf", goal: 520, line: "Merges can chain. Each wave multiplies the score until the soil settles." },
    { name: "Stone night", goal: 980, line: "Pebbles just sit there. A merge beside one cracks it. A moonbloom shatters it." },
    { name: "Rain market", goal: 1500, line: "Rain upgrades the highest plant in a column, or washes a pebble away." },
    { name: "Monsoon", goal: 0, line: "No finish line. Keep the planter alive and chase the garden's memory." }
  ];

  function loadSave() {
    try {
      var raw = JSON.parse(localStorage.getItem(KEY) || "{}");
      return {
        best: raw.best | 0,
        unlocked: Math.max(1, Math.min(5, raw.unlocked | 0 || 1)),
        mute: !!raw.mute
      };
    } catch (e) {
      return { best: 0, unlocked: 1, mute: false };
    }
  }

  function mount(canvas, options) {
    if (!canvas || canvas.__moonbloom) return canvas && canvas.__moonbloom;
    options = options || {};
    var atlasSrc = options.atlas || "/moonbloom/props.png";
    var save = loadSave();
    var ctx = canvas.getContext("2d");
    var dpr = 1;
    var cssW = 360;
    var cssH = 640;
    var raf = 0;
    var last = 0;
    var dead = false;
    var audio = null;
    var img = new Image();
    var imgReady = false;
    img.onload = function () { imgReady = true; };
    img.src = atlasSrc;

    var mode = "title";
    var evening = Math.min(save.unlocked, 5) - 1;
    var score = 0;
    var best = save.best;
    var grid = blank();
    var current = null;
    var next = null;
    var hover = 0;
    var keyCol = 2;
    var useKey = false;
    var busy = false;
    var anim = null;
    var particles = [];
    var floats = [];
    var shake = 0;
    var chainBanner = 0;
    var chainValue = 1;
    var deny = -1;
    var buttons = [];
    var pointerCol = -1;

    function blank() {
      var g = [];
      for (var r = 0; r < ROWS; r++) {
        var row = [];
        for (var c = 0; c < COLS; c++) row.push(null);
        g.push(row);
      }
      return g;
    }

    function persist() {
      try {
        localStorage.setItem(KEY, JSON.stringify({
          best: best, unlocked: save.unlocked, mute: save.mute, v: 1
        }));
      } catch (e) {}
    }

    function unlockAudio() {
      if (audio) return;
      var AC = window.AudioContext || window.webkitAudioContext;
      if (!AC) return;
      audio = new AC();
    }

    function resumeAudio() {
      if (audio && audio.state === "suspended") audio.resume();
    }

    function tone(freq, dur, type, gain) {
      if (!audio || save.mute) return;
      var t = audio.currentTime;
      var o = audio.createOscillator();
      var g = audio.createGain();
      o.type = type || "sine";
      o.frequency.setValueAtTime(freq, t);
      g.gain.setValueAtTime(gain, t);
      g.gain.exponentialRampToValueAtTime(0.001, t + dur);
      o.connect(g);
      g.connect(audio.destination);
      o.start(t);
      o.stop(t + dur);
    }

    function chord(freqs, dur, gain) {
      freqs.forEach(function (f, i) {
        setTimeout(function () { tone(f, dur, "triangle", gain); }, i * 40);
      });
    }

    function roll() {
      var bags = [
        [[0, 100]],
        [[0, 68], [1, 32]],
        [[0, 52], [1, 24], ["p", 24]],
        [[0, 46], [1, 16], ["p", 16], ["r", 22]],
        [[0, 40], [1, 16], [2, 12], ["p", 14], ["r", 18]]
      ];
      var bag = bags[Math.max(0, Math.min(4, evening))];
      var total = 0;
      bag.forEach(function (b) { total += b[1]; });
      var n = Math.random() * total;
      var pick = bag[0][0];
      for (var i = 0; i < bag.length; i++) {
        n -= bag[i][1];
        if (n <= 0) { pick = bag[i][0]; break; }
      }
      if (pick === "p") return { kind: "pebble" };
      if (pick === "r") return { kind: "rain" };
      return { kind: "plant", t: pick };
    }

    function pieceSprite(p) {
      if (!p) return 0;
      if (p.kind === "pebble") return 6;
      if (p.kind === "rain") return 7;
      return p.t;
    }

    function makeCell(p) {
      if (p.kind === "pebble") return { kind: "pebble", hp: 2, pop: 1.2, fallFrom: null };
      return { kind: "plant", t: p.t, pop: 1.2, fallFrom: null };
    }

    function landingRow(col) {
      for (var r = ROWS - 1; r >= 0; r--) if (!grid[r][col]) return r;
      return -1;
    }

    function canPlace(p) {
      if (!p) return false;
      if (p.kind === "rain") return true;
      for (var c = 0; c < COLS; c++) if (landingRow(c) >= 0) return true;
      return false;
    }

    function freshRun(index) {
      evening = index;
      score = 0;
      grid = blank();
      current = roll();
      next = roll();
      busy = false;
      anim = null;
      particles = [];
      floats = [];
      mode = "play";
      chainBanner = 0;
      hover = keyCol;
    }

    function noteScore(n, x, y) {
      score += n;
      if (score > best) { best = score; persist(); }
      floats.push({ n: n, x: x, y: y, t: 0, life: 0.8 });
    }

    function burst(x, y, color, count) {
      for (var i = 0; i < count; i++) {
        var a = Math.random() * Math.PI * 2;
        var s = 30 + Math.random() * 90;
        particles.push({
          x: x, y: y, vx: Math.cos(a) * s, vy: Math.sin(a) * s - 20,
          t: 0, life: 0.45 + Math.random() * 0.35, color: color, r: 2 + Math.random() * 2.5
        });
      }
    }

    function findGroups() {
      var seen = {};
      var groups = [];
      function key(r, c) { return r + "," + c; }
      for (var r = 0; r < ROWS; r++) {
        for (var c = 0; c < COLS; c++) {
          var cell = grid[r][c];
          if (!cell || cell.kind !== "plant" || seen[key(r, c)]) continue;
          var stack = [[r, c]];
          var group = [];
          seen[key(r, c)] = 1;
          while (stack.length) {
            var p = stack.pop();
            group.push(p);
            var dirs = [[1, 0], [-1, 0], [0, 1], [0, -1]];
            for (var d = 0; d < 4; d++) {
              var rr = p[0] + dirs[d][0];
              var cc = p[1] + dirs[d][1];
              if (rr < 0 || cc < 0 || rr >= ROWS || cc >= COLS) continue;
              if (seen[key(rr, cc)]) continue;
              var n = grid[rr][cc];
              if (n && n.kind === "plant" && n.t === cell.t) {
                seen[key(rr, cc)] = 1;
                stack.push([rr, cc]);
              }
            }
          }
          if (group.length >= 3) groups.push({ t: cell.t, cells: group });
        }
      }
      return groups;
    }

    function applyGroups(groups, chain) {
      var layout = measure();
      groups.forEach(function (g) {
        var anchor = g.cells[0];
