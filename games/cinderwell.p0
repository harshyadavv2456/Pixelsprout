window.Cinderwell = window.Cinderwell || {};
Cinderwell.mount = function(canvas){
  if(!canvas || canvas.dataset.live) return;
  canvas.dataset.live = "1";
  var ctx = canvas.getContext("2d");
  var state = "title";
  var score = 0, best = 0, combo = 0, drops = 0;
  try { best = parseInt(localStorage.getItem("cinderwell-best")||"0",10)||0; } catch(e){}
  var stack = [];
  var mover = null;
  var scraps = [];
  var flash = 0;
  var t = 0;
  var wind = 0;
  function resize(){
    var r = canvas.getBoundingClientRect();
    var dpr = Math.min(window.devicePixelRatio||1, 2);
    canvas.width = Math.max(280, r.width) * dpr;
    canvas.height = Math.max(360, r.height) * dpr;
    ctx.setTransform(dpr,0,0,dpr,0,0);
  }
  function W(){ return canvas.getBoundingClientRect().width || 360; }
  function H(){ return canvas.getBoundingClientRect().height || 520; }
  function reset(){
    score = 0; combo = 0; drops = 0; scraps = []; flash = 0; wind = 0;
    var w = W();
    stack = [{x: w*0.5 - 78, y: H()*0.72, w: 156, wick: false}];
    spawn();
    state = "play";
  }
  function spawn(){
    var top = stack[stack.length-1];
    var wick = (drops+1) % 4 === 0;
    mover = {x: 16, y: 86, w: top.w, dir: 1, wick: wick, vy: 0, falling: false};
  }
  function drop(){
    if(state === "title" || state === "over"){ reset(); return; }
    if(!mover || mover.falling) return;
    mover.falling = true;
    mover.vy = 0;
  }
  function land(){
    var top = stack[stack.length-1];
    var left = Math.max(mover.x, top.x);
    var right = Math.min(mover.x + mover.w, top.x + top.w);
    var overlap = right - left;
    if(overlap < 14){ end(); return; }
    var perfect = Math.abs(mover.x - top.x) < 6;
    var cut = mover.w - overlap;
    if(cut > 1){
      scraps.push({x: mover.x < top.x ? mover.x : right, y: mover.y, w: cut, vy: 2, wick: false});
    }
    var nw = perfect ? top.w : overlap;
    var nx = perfect ? top.x : left;
    if(mover.wick && perfect){
      nw = Math.min(nw + 18, 170);
      nx = top.x - (nw - top.w)/2;
      score += 40 + combo * 8;
      flash = 1;
      combo += 1;
    } else if(perfect){
      combo += 1;
      score += 15 + combo * 5;
      flash = 0.6;
    } else {
      combo = 0;
      score += Math.max(4, Math.round(nw/8));
    }
    drops += 1;
    wind = Math.sin(drops * 1.3) * Math.min(40, drops * 3);
    stack.push({x: nx, y: top.y - 28, w: nw, wick: !!(mover.wick && perfect)});
    if(nw < 18){ end(); return; }
    if(stack.length > 9){
      stack.shift();
      for(var i=0;i<stack.length;i++) stack[i].y += 28;
    }
    spawn();
  }
  function end(){
    state = "over";
    if(score > best){
      best = score;
      try { localStorage.setItem("cinderwell-best", String(best)); } catch(e){}
    }
  }
  function step(){
    t += 1;
    var w = W();
    if(state === "play" && mover){
      if(!mover.falling){
        var speed = 2.2 + Math.min(4.4, drops * 0.18);
        var gust = wind * 0.04;
        mover.x += mover.dir * speed + gust;
        var margin = 10;
        if(mover.x < margin){ mover.x = margin; mover.dir = 1; }
        if(mover.x + mover.w > w - margin){ mover.x = w - margin - mover.w; mover.dir = -1; }
      } else {
 